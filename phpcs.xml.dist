<?xml version="1.0"?>
<ruleset name="WP Photo Directory Importer">
	<description>WordPress Coding Standards ruleset for this plugin.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/js/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<!-- Requires wp-coding-standards/wpcs as a dev dependency. -->
	<rule ref="WordPress">
		<!-- Short array syntax and yoda conditions follow core defaults. -->
	</rule>

	<rule ref="WordPress.Files.FileName">
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="pdi"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="5.8"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
